[Unit]
Description=sidecar-relay bridge (sidecar /mint -> gateway {ok,ticket})
After=docker.service
Requires=docker.service

[Service]
Type=simple
Environment=MINT_UPSTREAM=http://127.0.0.1:8777
Environment=MINT_BRIDGE_KEY=change-me-please
Environment=MINT_BRIDGE_PORT=8778
ExecStart=/usr/bin/python3 /opt/sidecar-relay/bridge/mint_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
