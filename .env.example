# ---------- sidecar ----------
MINT_HEADLESS=0
SIDECAR_PORT=8777
MINT_MAX_CONC=3

# 住宅代理模板：票与铸造时的出口 IP 绑定，必须让铸造走**提交用的同一条住宅 session**。
# 占位符是单花括号 {sess}，不要写成 ${sess}（compose 会把它当变量插值吃掉）。
# 留空 = 直连铸票 = 提交恒 408（2026-11 之后机房 IP 铸的票全部被拒）。
# MINT_PROXY_TPL=http://USER-PASS-zone-custom-country-US-session-{sess}-sessTime-120:pass@proxy.example.com:10000

# 出口自检：铸票时比对「实际出口 IP」与「宿主出口 IP」，相同即判定代理未生效
MINT_EGRESS_CHECK=1

# ---------- 可选双通道 ----------
# 启用：docker compose --profile dual up -d
SIDECAR_OD_PORT=8776
MINT_OD_MAX_CONC=4

# ---------- bridge ----------
MINT_BRIDGE_KEY=change-me-please
MINT_BRIDGE_PORT=8778
# 单容器：两者都指向 8777。双通道：前台 8776、预热 8777
MINT_UPSTREAM=http://127.0.0.1:8777
MINT_WARM_UPSTREAM=http://127.0.0.1:8777
MINT_OD_TIMEOUT=75
